# ToyyibPay backend (index.js) -- copy to .env for local runs; on Render add these
# as Environment variables. Never commit the real .env.

# https://toyyibpay.com for live, https://dev.toyyibpay.com for sandbox
TOYYIBPAY_BASE=https://dev.toyyibpay.com
TOYYIBPAY_SECRET=your-toyyibpay-user-secret-key
TOYYIBPAY_CATEGORY=your-toyyibpay-category-code
# Set to false only while debugging sandbox callbacks
TOYYIBPAY_VERIFY_CALLBACK=true

FIREBASE_DB_URL=https://drive-ab344-default-rtdb.asia-southeast1.firebasedatabase.app/
# Full contents of the service-account JSON downloaded from
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"drive-ab344", ... }

PORT=3000
